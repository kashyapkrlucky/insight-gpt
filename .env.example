# ── App (runs on http://localhost:3001) ─────────────────────────────
# Postgres (Neon)
DATABASE_URL=

# ── Auth: Atlas ID (runs on http://localhost:3000) ──────────────────
NEXT_PUBLIC_AUTH_URL=http://localhost:3000
# OAuth client id registered in Atlas ID. Also the expected token audience.
NEXT_PUBLIC_CLIENT_ID=
# Atlas ID public key (PEM) for verifying RS256 access tokens.
JWT_PUBLIC_KEY=
# Optional. Expected `iss` claim (default: atlas-id).
JWT_ISSUER=atlas-id
# Optional. Comma-separated accepted `aud` values (default: NEXT_PUBLIC_CLIENT_ID).
JWT_AUDIENCE=

# ── Storage: Supabase ───────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_BUCKET_NAME=insight-pdf
# Server only. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ── Background jobs: Trigger.dev ────────────────────────────────────
TRIGGER_SECRET_KEY=

# ── AI: OpenAI ──────────────────────────────────────────────────────
AI_API_KEY=
# Embedding model (default: text-embedding-3-small)
AI_MODEL_TEXT_SMALL=text-embedding-3-small
# Chat model (default: gpt-5-mini)
AI_MODEL_CHAT=gpt-5-mini

# ── Vector DB: Qdrant ───────────────────────────────────────────────
QDRANT_URL=
QDRANT_API_KEY=
